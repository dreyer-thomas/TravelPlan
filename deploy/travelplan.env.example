# TravelPlan production environment — starting point for a new server.
#
# Every variable the application reads in production, with the reference deployment's
# non-secret values (plan.dreyer-travels.de) and EMPTY secrets. The full description of each
# variable is in docs/deployment-configuration.md#environment-variables.
#
# How to use it (pick one):
#   a) As it is done today: copy each line into the unit as Environment="NAME=value"
#      (/etc/systemd/system/TravelPlan.service, see docs/deployment-configuration.md#the-systemd-unit).
#   b) As an env file (the documented move, DW-331): copy to a path OUTSIDE the application tree,
#      e.g. /etc/travelplan/travelplan.env, `chown root:root` and `chmod 600`, and reference it from
#      the unit with EnvironmentFile=/etc/travelplan/travelplan.env. systemd reads it as root before
#      dropping to User=app, so the service user never needs read access.
#   Never name a copy `.env.production` inside travelplan/: Next.js auto-loads that name when
#   NODE_ENV=production and it would become a second config source.
#
# Not here, on purpose: PATH and ExecStart stay in the unit (Node 24 pinning); PORT and HOST are not
# read (`npm start` is `next start -p 3001 -H 127.0.0.1`).
#
# Format: NAME=value, one per line, no `export`. Double quotes are stripped by systemd and dotenv
# alike; use them for values with spaces. Never commit a filled-in copy.
# After changing the unit or the file: sudo systemctl daemon-reload && sudo systemctl restart TravelPlan

# --- Runtime -------------------------------------------------------------------------------------
# Must be production on a server: it switches on the startup checks below and real SMTP sending.
NODE_ENV=production

# --- Required --------------------------------------------------------------------------------------
# SQLite database. Absolute path. Note: inside the application tree (DW-328), so a deploy must update
# the tree in place, never replace it. The deploy script backs this file up before every deploy.
DATABASE_URL=file:/home/app/apps/TravelPlan/travelplan/prisma/prod.db

# SECRET. Session signing key (HS256); also keys the day-change receipt MAC. Changing it signs
# every user out. Generate with: openssl rand -base64 32
JWT_SECRET=

# Directory for uploaded photos and documents. Absolute path OUTSIDE the application tree, owned by
# the service user. The server answers 500 on every request until it is set and usable.
MEDIA_STORAGE_ROOT=/var/lib/travelplan/media

# Public origin, used for the link in password-reset mails (and as contact in the Wikimedia
# User-Agent). Falls back to http://localhost:3000 WITHOUT a warning, so always set it.
APP_BASE_URL=https://plan.dreyer-travels.de

# --- Password-reset mail (required in production) ---------------------------------------------------
# With NODE_ENV=production the server refuses to serve (500, reason in the journal) until all five
# are set. Values below are the Strato setup.
SMTP_HOST=smtp.strato.de
# 465 = implicit TLS. Any other port must offer STARTTLS; 587 is the fallback if 465 is blocked.
SMTP_PORT=465
SMTP_USER=webmaster@dreyer-travels.de
# SECRET. The MAILBOX password ("Postfach bearbeiten" at Strato), not the Strato customer login.
SMTP_PASS=
# From header. The address must be one the SMTP_USER mailbox owns (an alias works).
MAIL_FROM="TravelPlan <system@plan.dreyer-travels.de>"

# --- Optional ------------------------------------------------------------------------------------
# Route-geometry service. Leave empty for the public https://routing.openstreetmap.de; set it only
# for a self-hosted OSRM.
OSRM_BASE_URL=

# SECRET. AI day suggestions; the feature is off while this is empty. Every search is paid by the
# operator: set a spend limit in the Anthropic console before adding the key.
ANTHROPIC_API_KEY=
# Model for the suggestions. Empty means claude-haiku-5-5.
ANTHROPIC_MODEL=
# Searches per user per server-local day. Empty or invalid means 20. Kept in memory, reset on restart.
AI_SUGGESTIONS_DAILY_LIMIT=20

# Connector for AI assistants (Story 15.1, Epic 15). Off unless exactly "true": every connector endpoint
# (/.well-known/oauth-*, /oauth/authorize, /api/oauth/*, /api/mcp) then answers 404. When on, APP_BASE_URL
# must be https or the server refuses to start. Users add https://plan.dreyer-travels.de/api/mcp as a
# custom connector in Claude.
MCP_ENABLED=
# Comma-separated hosts whose client ID metadata documents may connect. Empty means claude.ai (Claude's
# hosted apps and Claude Code). A refused client is logged as "client_id host not allowed: <host>".
MCP_CLIENT_ID_HOSTS=claude.ai

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
}

// SQLite has no native enum. `users.role` is a plain `TEXT NOT NULL DEFAULT 'OWNER'` column with no
// CHECK constraint (see `20260212164546_init`), so adding a member is a client-side change only and
// emits no DDL - `prisma migrate diff` against the migrations directory stays empty for this table.
// Verified for this story rather than assumed, the way Story 6.16 verified it for
// `TravelTransportType`. Every stored row keeps its value; `ADMIN` is purely additive.
//
// `OWNER` is the account-level default every self-registration gets (`register/route.ts`), which is
// why it is *not* an administrator marker - and why `ADMIN` had to exist at all. Note also that
// `UserRole.OWNER` and "owner of a trip" (`Trip.userId`) are unrelated things wearing one word;
// adding `ADMIN` here does not fix that collision and the code does not pretend it does.
enum UserRole {
  OWNER
  VIEWER
  ADMIN
}

enum TripMemberRole {
  VIEWER
  CONTRIBUTOR
}

enum PreferredLanguage {
  en
  de
}

enum AiUsageOutcome {
  ok
  failed
}

enum AccommodationStatus {
  PLANNED
  BOOKED
}

// Story 13.1 (FR46). A FLEXIBLE activity is planned by its duration and the schedule works out its
// times; a FIXED one is booked and keeps its times. SQLite stores the value as plain TEXT.
enum DayPlanItemScheduleMode {
  FLEXIBLE
  FIXED
}

enum TravelSegmentItemType {
  ACCOMMODATION
  DAY_PLAN_ITEM
}

// SQLite has no native enum. `travel_segments.transport_type` is a plain TEXT column with no CHECK
// constraint (see 20260301105118_add_travel_segments), so widening this enum is a client-side change
// only and emits no DDL - `prisma migrate diff` against the migrations directory stays empty for
// this table. Every stored row keeps its value; every member added since the original CAR, SHIP and
// FLIGHT (WALKING and CYCLING in Story 6.16, TRAIN and BUS in Story 6.31) is purely additive.
enum TravelTransportType {
  CAR
  SHIP
  FLIGHT
  WALKING
  CYCLING
  TRAIN
  BUS
}

model User {
  id                 String   @id @default(cuid()) @map("id")
  email              String   @unique @map("email")
  passwordHash       String   @map("password_hash")
  role               UserRole @default(OWNER) @map("role")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  preferredLanguage PreferredLanguage @default(en) @map("preferred_language")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  passwordResetTokens PasswordResetToken[]
  memberships        TripMember[]
  trips        Trip[]
  aiUsageRecords AiUsageRecord[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthTokens OAuthToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false) @map("used")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@unique([tokenHash])
  @@map("password_reset_tokens")
}

model Trip {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  name      String   @map("name")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  heroImageUrl String? @map("hero_image_url")
  startLocationLat Float? @map("start_location_lat")
  startLocationLng Float? @map("start_location_lng")
  startLocationLabel String? @map("start_location_label")
  destinationLocationLat Float? @map("destination_location_lat")
  destinationLocationLng Float? @map("destination_location_lng")
  destinationLocationLabel String? @map("destination_location_label")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  members TripMember[]
  days  TripDay[]
  dayPlanItems DayPlanItem[]

  @@index([userId])
  @@map("trips")
}

model TripMember {
  id        String         @id @default(cuid()) @map("id")
  tripId    String         @map("trip_id")
  userId    String         @map("user_id")
  role      TripMemberRole @map("role")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId], map: "idx_trip_members_trip_id")
  @@index([userId], map: "idx_trip_members_user_id")
  @@unique([tripId, userId], map: "trip_members_trip_id_user_id_key")
  @@map("trip_members")
}

model TripDay {
  id        String   @id @default(cuid()) @map("id")
  tripId    String   @map("trip_id")
  date      DateTime @map("date")
  dayIndex  Int      @map("day_index")
  imageUrl  String?  @map("image_url")
  note      String?  @map("note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  accommodation Accommodation?
  dayPlanItems  DayPlanItem[]
  travelSegments TravelSegment[]

  @@index([tripId], map: "idx_trip_days_trip_id")
  @@map("trip_days")
}

model TravelSegment {
  id        String   @id @default(cuid()) @map("id")
  tripDayId String   @map("trip_day_id")
  fromItemType TravelSegmentItemType @map("from_item_type")
  fromItemId String   @map("from_item_id")
  toItemType TravelSegmentItemType @map("to_item_type")
  toItemId String   @map("to_item_id")
  transportType TravelTransportType @map("transport_type")
  durationMinutes Int @map("duration_minutes")
  distanceKm Float? @map("distance_km")
  linkUrl   String?  @map("link_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tripDay TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId], map: "idx_travel_segments_trip_day_id")
  @@unique([tripDayId, fromItemType, fromItemId, toItemType, toItemId], map: "idx_travel_segments_pair")
  @@map("travel_segments")
}

model Accommodation {
  id        String   @id @default(cuid()) @map("id")
  tripDayId String   @unique(map: "idx_accommodations_trip_day_id") @map("trip_day_id")
  name      String   @map("property_name")
  status    AccommodationStatus @default(PLANNED) @map("status")
  costCents Int?     @map("cost_cents")
  costOriginalAmount Int? @map("cost_original_amount")
  costCurrency String? @map("cost_currency")
  costRate Float? @map("cost_rate")
  costRateDate String? @map("cost_rate_date")
  link      String?  @map("link_url")
  locationLat Float? @map("location_lat")
  locationLng Float? @map("location_lng")
  locationLabel String? @map("location_label")
  notes     String?  @map("notes")
  checkInTime String? @map("check_in_time")
  checkOutTime String? @map("check_out_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tripDay TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  images  AccommodationImage[]
  documents AccommodationDocument[]
  payments CostPayment[]

  @@map("accommodations")
}

// Story 14.1 (FR30, FR31). An activity belongs to its trip directly; `tripDayId = null` means it is
// parked on the trip's bucket list. Prisma cannot express the SQLite CHECK that guards a parked row
// (FLEXIBLE, both times null, `sort_order = 0`), so it lives in the migration
// `20261018120000_day_plan_items_without_day` and is guarded by its test. Every trip-level reader
// reaches activities through the day; only the bucket list reads `tripId` with `tripDayId: null`.
model DayPlanItem {
  id        String   @id @default(cuid()) @map("id")
  tripId    String   @map("trip_id")
  tripDayId String?  @map("trip_day_id")
  title     String?  @map("title")
  fromTime  String?  @map("from_time")
  toTime    String?  @map("to_time")
  contentJson String @map("content_json")
  costCents Int?     @map("cost_cents")
  costOriginalAmount Int? @map("cost_original_amount")
  costCurrency String? @map("cost_currency")
  costRate Float? @map("cost_rate")
  costRateDate String? @map("cost_rate_date")
  linkUrl   String?  @map("link_url")
  locationLat Float? @map("location_lat")
  locationLng Float? @map("location_lng")
  locationLabel String? @map("location_label")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Story 13.1. Every production write sets all three explicitly; the defaults exist for the
  // migration's ALTER TABLE (SQLite needs one for a NOT NULL column) and for rows a test seeds
  // directly. They must equal the SQL defaults or `prisma migrate diff` drifts. A FLEXIBLE row's
  // `fromTime`/`toTime` are the schedule's result, and both `null` mean "does not fit in the day";
  // a FIXED row always has both. `sortOrder` is the day's order, dense (0..n-1) per day, not unique.
  scheduleMode    DayPlanItemScheduleMode @default(FIXED) @map("schedule_mode")
  durationMinutes Int @default(15) @map("duration_minutes")
  sortOrder       Int @default(0) @map("sort_order")

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripDay TripDay? @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  images  DayPlanItemImage[]
  documents DayPlanItemDocument[]
  payments CostPayment[]

  @@index([tripDayId], map: "idx_day_plan_items_trip_day_id")
  @@index([tripDayId, sortOrder], map: "idx_day_plan_items_trip_day_sort_order")
  @@index([tripId, tripDayId], map: "idx_day_plan_items_trip_id_trip_day_id")
  @@map("day_plan_items")
}

model CostPayment {
  id              String   @id @default(cuid()) @map("id")
  accommodationId String?  @map("accommodation_id")
  dayPlanItemId   String?  @map("day_plan_item_id")
  amountCents     Int      @map("amount_cents")
  amountOriginal  Int?     @map("amount_original")
  dueDate         String   @map("due_date")
  sortOrder       Int      @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Prisma cannot express the SQLite one-target CHECK constraint, so it is
  // enforced in SQL migration files and guarded by tests.
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  dayPlanItem   DayPlanItem?   @relation(fields: [dayPlanItemId], references: [id], onDelete: Cascade)

  @@index([accommodationId], map: "idx_cost_payments_accommodation_id")
  @@index([dayPlanItemId], map: "idx_cost_payments_day_plan_item_id")
  @@map("cost_payments")
}

model AccommodationImage {
  id              String   @id @default(cuid()) @map("id")
  accommodationId String   @map("accommodation_id")
  imageUrl        String   @map("image_url")
  sortOrder       Int      @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([accommodationId], map: "idx_accommodation_images_accommodation_id")
  @@unique([accommodationId, sortOrder], map: "idx_accommodation_images_order")
  @@map("accommodation_images")
}

model DayPlanItemImage {
  id            String   @id @default(cuid()) @map("id")
  dayPlanItemId String   @map("day_plan_item_id")
  imageUrl      String   @map("image_url")
  sortOrder     Int      @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  dayPlanItem DayPlanItem @relation(fields: [dayPlanItemId], references: [id], onDelete: Cascade)

  @@index([dayPlanItemId], map: "idx_day_plan_item_images_item_id")
  @@unique([dayPlanItemId, sortOrder], map: "idx_day_plan_item_images_order")
  @@map("day_plan_item_images")
}

// Documents (Story 9.1) are the image galleries' shape plus `file_name`. The on-disk name is
// server-generated (`doc-<ts>-<rand>.<ext>`) and carries no trace of what the user called the file,
// so the name has to be stored: it is the chip's label and the backup has to round-trip it. It is a
// column value only - nothing on disk is ever named from client input.
model AccommodationDocument {
  id              String   @id @default(cuid()) @map("id")
  accommodationId String   @map("accommodation_id")
  documentUrl     String   @map("document_url")
  fileName        String   @map("file_name")
  sortOrder       Int      @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([accommodationId], map: "idx_accommodation_documents_accommodation_id")
  @@unique([accommodationId, sortOrder], map: "idx_accommodation_documents_order")
  @@map("accommodation_documents")
}

model DayPlanItemDocument {
  id            String   @id @default(cuid()) @map("id")
  dayPlanItemId String   @map("day_plan_item_id")
  documentUrl   String   @map("document_url")
  fileName      String   @map("file_name")
  sortOrder     Int      @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  dayPlanItem DayPlanItem @relation(fields: [dayPlanItemId], references: [id], onDelete: Cascade)

  @@index([dayPlanItemId], map: "idx_day_plan_item_documents_item_id")
  @@unique([dayPlanItemId, sortOrder], map: "idx_day_plan_item_documents_order")
  @@map("day_plan_item_documents")
}

// Story 8.7. One row per AI day search that reached Claude: what it consumed, never what it asked or
// answered - no prompt, wish, place, trip or day (Story 12.1's privacy rule). Cost is computed at display
// time from these counts and the price table in `src/lib/ai/config.ts`, so no price is stored.
//
// The only `SetNull` relation in this schema, on purpose: everything else cascades, but a deleted
// account's searches were still paid for, so the rows stay (with `user_id` cleared) and a month's totals
// do not shrink when an account goes.
model AiUsageRecord {
  id                       String         @id @default(cuid()) @map("id")
  createdAt                DateTime       @default(now()) @map("created_at")
  userId                   String?        @map("user_id")
  model                    String         @map("model")
  outcome                  AiUsageOutcome @map("outcome")
  durationMs               Int            @map("duration_ms")
  inputTokens              Int            @default(0) @map("input_tokens")
  cacheCreationInputTokens Int            @default(0) @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int            @default(0) @map("cache_read_input_tokens")
  outputTokens             Int            @default(0) @map("output_tokens")
  webSearchRequests        Int            @default(0) @map("web_search_requests")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "ai_usage_records_created_at_idx")
  @@index([userId], map: "ai_usage_records_user_id_idx")
  @@map("ai_usage_records")
}

// Story 15.1. The connector's OAuth state: authorization codes and opaque access/refresh tokens, stored only
// as SHA-256 hashes. A "family" is one connection, created by one consent: every token issued from it,
// rotated refresh tokens included, carries its `familyId`, and revocation marks the whole family. Rows are
// marked revoked rather than deleted so reuse of a rotated refresh token is still recognised; expired rows
// are deleted a day after expiry. Clients are identified by their metadata-document URL (`clientId`), so
// there is no client table. Deleting a user deletes all of it.
enum OAuthTokenKind {
  ACCESS
  REFRESH
}

model OAuthAuthorizationCode {
  id            String    @id @default(cuid()) @map("id")
  codeHash      String    @unique @map("code_hash")
  userId        String    @map("user_id")
  clientId      String    @map("client_id")
  clientName    String    @map("client_name")
  redirectUri   String    @map("redirect_uri")
  codeChallenge String    @map("code_challenge")
  resource      String    @map("resource")
  scope         String    @map("scope")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  familyId      String?   @map("family_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_oauth_authorization_codes_expires_at")
  @@index([userId], map: "idx_oauth_authorization_codes_user_id")
  @@map("oauth_authorization_codes")
}

model OAuthToken {
  id              String         @id @default(cuid()) @map("id")
  tokenHash       String         @unique @map("token_hash")
  kind            OAuthTokenKind @map("kind")
  familyId        String         @map("family_id")
  userId          String         @map("user_id")
  clientId        String         @map("client_id")
  clientName      String         @map("client_name")
  scope           String         @map("scope")
  resource        String         @map("resource")
  // Story 15.3. The redirect URI of the consent that created the family, for the host shown under
  // Connected apps. Null for families issued before the column existed.
  redirectUri     String?        @map("redirect_uri")
  expiresAt       DateTime       @map("expires_at")
  familyExpiresAt DateTime       @map("family_expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  lastUsedAt      DateTime?      @map("last_used_at")
  rotatedAt       DateTime?      @map("rotated_at")
  revokedAt       DateTime?      @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId], map: "idx_oauth_tokens_family_id")
  @@index([userId], map: "idx_oauth_tokens_user_id")
  @@index([expiresAt], map: "idx_oauth_tokens_expires_at")
  @@map("oauth_tokens")
}

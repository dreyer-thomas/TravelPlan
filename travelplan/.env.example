# Every variable the application reads (see docs/deployment-configuration.md#environment-variables).
# Copy to .env (or .env.local) for local development and fill in what you need; commented-out lines
# are optional or have a default. Never commit real values.

# --- Required ---
# SQLite connection string.
DATABASE_URL=file:./prisma/dev.db
# Session signing key (HS256). Generate one with: openssl rand -base64 32
JWT_SECRET=
# Absolute path to the uploaded-media directory, outside the application tree. Required in production.
# MEDIA_STORAGE_ROOT=

# --- Silent fallbacks: set these in production ---
# Public origin for password-reset email links. Defaults to http://localhost:3000.
APP_BASE_URL=http://localhost:3000

# --- Required in production only (Story 8.8) ---
# SMTP for password-reset email. Ignored in development and test, where mail goes to an in-memory
# outbox and no connection is made. In production the server refuses to start without all five.
# SMTP_HOST=smtp.strato.de
# 465 = implicit TLS; any other port must offer STARTTLS (587 is the fallback).
# SMTP_PORT=465
# SMTP_USER=webmaster@dreyer-travels.de
# The MAILBOX password ("Postfach bearbeiten" at Strato), not the Strato customer login.
# SMTP_PASS=
# MAIL_FROM="TravelPlan <system@plan.dreyer-travels.de>"

# --- Optional ---
# Route-geometry service. Defaults to https://routing.openstreetmap.de.
# OSRM_BASE_URL=

# AI day suggestions (Story 12.1). Off without a key; every search is paid by the operator.
# Set a spend limit in the Anthropic console before adding the key.
# ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5. A claude-haiku-* model gets the basic web search tool
# (web_search_20250305); any other model the dynamic-filtering one (web_search_20260209).
# ANTHROPIC_MODEL=
# Searches per user per server-local day. Defaults to 20.
# AI_SUGGESTIONS_DAILY_LIMIT=

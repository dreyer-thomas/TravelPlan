# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
prisma/dev.db
prisma/*.db
prisma/test.db
prisma/test-*.db
prisma/test-migrate-*.lock

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/var/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow .env.example to be committed)
.env
.env.local
# .env.production is not hypothetical: production secrets live in the systemd unit today,
# and the documented way to move them out is an env file. Next.js also auto-loads this exact
# name when NODE_ENV=production, so an in-tree copy would silently become a second config
# source as well as a commit hazard. See DW-331.
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
